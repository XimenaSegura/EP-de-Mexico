{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist))/i]",
        "message": "Font not provided by the design system. Available: Geist."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-deep",
      "--accent-on-dark",
      "--bg",
      "--bg-2",
      "--container",
      "--dur",
      "--dur-fast",
      "--dur-slow",
      "--ease",
      "--font-mono",
      "--font-sans",
      "--font-serif",
      "--fs-body",
      "--fs-display",
      "--fs-h2",
      "--fs-h3",
      "--fs-hero",
      "--fs-lede",
      "--fs-lede-sm",
      "--fs-mono",
      "--fs-sm",
      "--fs-stage",
      "--fw-medium",
      "--fw-regular",
      "--fw-semi",
      "--gutter",
      "--ink",
      "--ink-2",
      "--lh-body",
      "--lh-head",
      "--lh-hero",
      "--line",
      "--line-on-dark",
      "--line-strong",
      "--muted",
      "--muted-2",
      "--on-ink",
      "--on-ink-faint",
      "--on-ink-soft",
      "--radius-md",
      "--radius-none",
      "--radius-pill",
      "--radius-sm",
      "--section-y",
      "--shadow-btn-hover",
      "--shadow-float",
      "--shadow-panel",
      "--status-away",
      "--status-busy",
      "--status-offline",
      "--status-online",
      "--track-eyebrow",
      "--track-head",
      "--track-mono"
    ],
    "tokenKinds": {
      "--bg": "color",
      "--bg-2": "color",
      "--ink": "color",
      "--ink-2": "color",
      "--muted": "color",
      "--muted-2": "color",
